PORT=3000
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3-church
DATABASE_PATH=./chatbdg.sqlite

# The owner's Cloudflare Access email — gets the personal system prompt and
# owns conversations created before per-user support existed. Any other
# email Access authenticates gets the generic shared prompt instead.
OWNER_EMAIL=

# Identity fallback ONLY when there is no Cf-Access-Jwt-Assertion header at
# all (e.g. local development not going through the tunnel). Defaults to
# OWNER_EMAIL if unset. A request that DOES carry an Access JWT is always
# identified from that verified token instead — this fallback never applies
# to real traffic through the tunnel.
DEFAULT_LOCAL_USER_EMAIL=

# Cloudflare Access application settings, used to cryptographically verify
# the Cf-Access-Jwt-Assertion header rather than trusting the plaintext
# Cf-Access-Authenticated-User-Email header (which a client could otherwise
# set to any value). Team domain: Zero Trust dashboard > Settings. AUD tag:
# Access > Applications > (this app) > Overview > "Application Audience (AUD) Tag".
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=

# Optional cloud provider (Gemini) — only needed if you use the "Cloud" toggle in the UI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
